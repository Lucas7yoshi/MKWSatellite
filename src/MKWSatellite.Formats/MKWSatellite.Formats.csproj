<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game file formats (BYML, zstd, course scenes, later BFRES/BNTX/Phive). No UI or GPU dependencies. -->
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <!-- No PDB in published packages (the executables' publish settings do not reach this project). -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
