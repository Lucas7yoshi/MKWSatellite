<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>MKWSatellite</AssemblyName>
  </PropertyGroup>

  <!-- Publishing (see dist/README.md): English resources only, no PDBs. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" />
    <PackageReference Include="Silk.NET.Windowing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MKWSatellite.Formats\MKWSatellite.Formats.csproj" />
  </ItemGroup>

</Project>
